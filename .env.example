# Copy to `.env` and fill in. `.env` is gitignored.
#
# The pipeline talks to *local* models, so these are endpoints on your own
# machine/cluster, not paid APIs. The key is usually a dummy string that the
# local server ignores, but the OpenAI client requires it to be non-empty.

# --- OpenAI-compatible local server (vLLM / SGLang / Ollama / llama.cpp / LM Studio) ---
CMB_BASE_URL=http://localhost:8000/v1
CMB_API_KEY=EMPTY

# --- Hugging Face ---
# Needed for gated repos: google/gemma-*, meta-llama/*.
# Request access on the model page first, then paste a read token here.
HF_TOKEN=

# Where to keep downloaded weights + dataset cache (optional; defaults to ~/.cache).
# HF_HOME=/mnt/big-disk/hf
# HF_HUB_ENABLE_HF_TRANSFER=1

# --- GPU selection for scripts/serve_vllm.sh ---
CUDA_VISIBLE_DEVICES=0
